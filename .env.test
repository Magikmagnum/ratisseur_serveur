# Définition des variables d'environnement pour l'environnement de test

# Spécifie la classe Kernel utilisée par Symfony
KERNEL_CLASS="App\Kernel"

# Clé secrète pour les tests (à ne pas utiliser en production)
APP_SECRET="ecretf0rt3st" # Suppression du "$" au début, qui pourrait causer des problèmes d'interprétation

# Gestion des avertissements de dépréciation Symfony
SYMFONY_DEPRECATIONS_HELPER="max[self]=0"

# Configuration de Panther pour les tests e2e
PANTHER_APP_ENV="panther"
PANTHER_ERROR_SCREENSHOT_DIR="./var/error-screenshots"

# Connexion à la base de données pour les tests
DATABASE_URL="mysql://root:@db_ratisseur:3306/ratisseur?serverVersion=8.0.32&charset=utf8mb4"